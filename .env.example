PORT=3000
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_SECRET=123456
DATABASE_URL=

# Real payment gateway
DEMO_MODE=false
UPIQRPAY_BASE_URL=https://upiqrpay.in/api/v1
UPIQRPAY_API_KEY=
UPIQRPAY_WEBHOOK_SECRET=
# Public HTTPS URL that UPIQRPay can reach. For temporary local testing,
# use an HTTPS tunnel URL and keep this value private in .env.
PUBLIC_BASE_URL=https://YOUR-TEMPORARY-HTTPS-URL
